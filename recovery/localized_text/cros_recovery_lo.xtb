<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="1201402288615127009">ຕໍ່ໄປ</translation>
<translation id="1207194515919037363">ໂມດູນຄວາມປອດໄພໃນອຸປະກອນນີ້ໃຊ້ບໍ່ໄດ້.

ກະລຸນາເບິ່ງ URL ນີ້ສຳລັບຂໍ້ມູນເພີ່ມເຕີມ:

https://www.google.com/chromeos/recovery</translation>
<translation id="1246412656779440622">ເກີດມີບັນຫາໃນການໂຫຼດເຄືອຂ່າຍທີ່ສາມາດໃຊ້ໄດ້, ກະລຸນາລອງໃໝ່</translation>
<translation id="1483971085438511843">ໃຊ້ປຸ່ມ Enter ເພື່ອເລືອກຕົວເລືອກ.</translation>
<translation id="1486534340494484631">ເກີດຜິດພາດໃນລະຫວ່າງການລຶບຂໍ້ມູນດິສທີ່ເພີ່ມປະສິດທິພາບ.

ການກູ້ຄືນລະບົບສຳເລັດແລ້ວ.
ກະລຸນາລຶບສື່ການກູ້ຄືນ ແລະ ຄອມພິວເຕີຂອງທ່ານຈະຣິສະຕາດໂດຍອັດຕະໂນມັດ.</translation>
<translation id="1600199746926806589">ລະບົບຈະລົງທະບຽນອຸປະກອນຂອງທ່ານໂດຍອັດຕະໂນມັດເຂົ້າໃນໂດເມນທີ່ປາກົດຢູ່ຂ້າງລຸ່ມ.
ກະລຸນາຢັ້ງຢືນວ່າມັນຖືກຕ້ອງຫຼືບໍ່.</translation>
<translation id="1638626287317244115">ສຳເນົາບັນທຶກ</translation>
<translation id="175933110504178679">ຂັ້ນຕອນນີ້ຈະລ້າງຂໍ້ມູນສ່ວນຕົວຂອງທ່ານ. ຂັ້ນຕອນນີ້ຈະໃຊ້ເວລາຫຼາຍນາທີ. ກະລຸນາຢ່າປິດອຸປະກອນ.</translation>
<translation id="1995660704900986789">ປິດເຄື່ອງ</translation>
<translation id="2160704550417277456">ຕົວເລືອກຂັ້ນສູງ</translation>
<translation id="2161775569013928937">ເລີ່ມການກູ້ຄືນບໍ?</translation>
<translation id="2249183435483068136">ຂໍ້ມູນການເຂົ້າສູ່ລະບົບບໍ່ຖືກຕ້ອງ</translation>
<translation id="2367943141906694421">ບໍ່ສາມາດຊອກຫາເຄືອຂ່າຍໃດໆໄດ້</translation>
<translation id="2437368373459239842">ຂັ້ນຕອນນີ້ຈະໃຊ້ເວລາສອງສາມນາທີ</translation>
<translation id="2596600434078055015">ຕົວເລືອກດີບັກໃນການກູ້ຄືນ</translation>
<translation id="2704439832119932045">ເລືອກຊ່ອງ ແລະ ເວີຊັນລະບົບປະຕິບັດການເພື່ອສືບຕໍ່ການກູ້ຄືນ</translation>
<translation id="2731700343119398978">ກະ​ລຸ​ນາ​ລໍ​ຖ້າ...</translation>
<translation id="2904079386864173492">ໂມເດວ:</translation>
<translation id="2924925097667803013">http://google.com/chromeos/recovery</translation>
<translation id="300775974721831513">​ເຈົ້າ​ຂອງ​ອຸ​ປະ​ກອນ​ຕ້ອງ​ການ​ໃຫ້​ອຸ​ປະ​ກອນ​ນີ້​ແລ່ນ​ດ້ວຍ​ການ​ຢືນ​ຢັນ Chrome OS
ເປີດ.  ທ່ານ​ກຳ​ລັງ​ພະ​ຍາ​ຍາມ​ຕິດ​ຕັ້ງ​ຮູບ​ການ​ກູ້​ຄືນ
Chrome OS ບໍ່​ເປັນ​ທາງ​ການ ເຊິ່ງ​ບໍ່​ຜ່ານ​ການ​ຢືນ​ຢັນ.

ສຳ​ລັບ​ຂໍ້​ມູນ​ເພີ່ມ​ເຕີມ, ​ໃຫ້​ເບິ່ງ URL ນີ້:

https://www.google.com/chromeos/devmode</translation>
<translation id="3029977119648083072">ໃສ່ລະຫັດຜ່ານເຄືອຂ່າຍ</translation>
<translation id="3243756202241744259">ກຳ​ລັງ​ກວດ​ສອບ​ຄວາມ​ສົມ​ບູນ​ຂອງ​ມີ​ເດຍ​ການ​ກູ້​ຄືນ​ຂອງ​ທ່ານ...</translation>
<translation id="3283913352572436199">ມີການກຳນົດຄ່າສື່ການກູ້ຄືນຂອງທ່ານສຳລັບການຕັ້ງຄ່າອັດຕະໂນມັດຫຼັງຈາກມັນປິດເປີດເຄື່ອງໃໝ່.

ເພື່ອດຳເນີນການຕັ້ງຄ່າອັດຕະໂນມັດ, ກະລຸນາກົດປຸ່ມເພີ່ມສຽງຂຶ້ນ, ຫຼືບໍ່ດັ່ງນັ້ນ
ກົດປຸ່ມຜ່ອນສຽງລົງ. ຖ້າທ່ານຕ້ອງການຍົກເລີກການກູ້ຄືນ, ກະລຸນາກົດປຸ່ມປິດເປີດເຄື່ອງ
ແລະ ກົດມັນຄ້າງໄວ້ຈົນກວ່າວ່າອຸປະກອນປິດເຄື່ອງ (ນີ້ໃຊ້ເວລາບໍ່ເກີນ 8 ວິນາທີ).</translation>
<translation id="33938768013536853">ແບັດເຕີຣີຕໍ່າເກີນໄປສຳລັບການອັບເດດ.

ກະລຸນາສຽບໄຟ Chromebook ຂອງທ່ານ. ການອັບເດດ
ຈະເລີ່ມໂດຍອັດຕະໂນມັດໃນທັນທີທີ່ແບັດເຕີຣີມີໄຟພຽງພໍ.</translation>
<translation id="3554552348994984455">ເລີ່ມການກູ້ຄືນ</translation>
<translation id="369510862371290019">ມີການກຳນົດຄ່າສື່ການກູ້ຄືນຂອງທ່ານສຳລັບການຕັ້ງຄ່າອັດຕະໂນມັດຫຼັງຈາກມັນປິດເປີດເຄື່ອງໃໝ່.

ເພື່ອດຳເນີນການຕັ້ງຄ່າອັດຕະໂນມັດ, ກະລຸນາກົດປຸ່ມກູ້ຄືນຂອງອຸປະກອນ.
ຖ້າທ່ານຕ້ອງການຍົກເລີກການກູ້ຄືນ, ກະລຸນາກົດປຸ່ມປິດເປີດເຄື່ອງຄ້າງໄວ້
ຈົນກວ່າວ່າອຸປະກອນປິດເຄື່ອງ (ນີ້ໃຊ້ເວລາບໍ່ເກີນ 8 ວິນາທີ).</translation>
<translation id="3723985428118783104">ກຳລັງກູ້ຄືນຢູ່</translation>
<translation id="3750930141330200643">ທ່ານ​ກຳ​ລັງ​ໃຊ້​ຮູບ​ການ​ກູ້​ຄືນ Chrome OS ຫຼ້າ​ສະ​ໄໝ​.

ກະ​ລຸ​ນາ​ເບິ່ງ URL ນີ້​ສຳ​ລັບ​ຄຳ​ແນະ​ນຳ​ກ່ຽວ​ກັບ​ວິ​ທີ​ສ້າງມີ​ເດຍ​ການ​ກູ້​ຄືນ​ໃໝ່:

https://www.google.com/chromeos/recovery</translation>
<translation id="385051799172605136">ກັບ​ຄືນ​</translation>
<translation id="3928994486545789273">ເລືອກເຄືອຂ່າຍ</translation>
<translation id="3942420633017001071">ການກວດວິເຄາະບັນຫາ</translation>
<translation id="3946632524220974380">ຈຳ​ເປັນ​ຕ້ອງ​ໄດ້​ເຮັດ​ການ​ປ່ຽນ​ແປງ​ປຸ່ມ​ຜູ້​ພັດ​ທະ​ນາ​ເພື່ອ​ສືບ​ຕໍ່; ການ​ດຳ​ເນີນ​ການ​ຕ້ອງ​ການ​ເວ​ລາ 5 ນາ​ທີ.</translation>
<translation id="4006102694824401878">ຂັ້ນຕອນນີ້ອາດໃຊ້ເວລາສອງສາມນາທີ</translation>
<translation id="4007898787815310968">ເກີດຜິດພາດໃນລະຫວ່າງການລຶບຂໍ້ມູນດິສທີ່ເພີ່ມປະສິດທິພາບ.

ເກີດຂໍ້ຜິດພາດທີ່ບໍ່ຄາດຄິດຂຶ້ນໃນລະຫວ່າງການກູ້ຄືນ. ກະລຸນາເບິ່ງ URL ນີ້ສຳລັບເຄັດລັບການແກ້ໄຂບັນຫາ:

https://www.google.com/chromeos/recovery</translation>
<translation id="4157577338965464221">ເຄືອຂ່າຍທີ່ສາມາດໃຊ້ໄດ້</translation>
<translation id="4261250127007881003">ບັນທຶກຂໍ້ຄວາມ</translation>
<translation id="4287891348859705498">ສຳເນົາບັນທຶກໄວ້ໃນດິສພາຍນອກຂອງທ່ານ</translation>
<translation id="436588829138218801">ການ​ຢືນ​ຢັນ Chrome OS ປິດ.

ຖ້າ​ອັນ​ນີ້​ບໍ່​ໄດ້​ຕັ້ງ​ໃຈ​ໄວ້, ທ່ານ​ຄວນ​ຍົກ​ເລີກ​ການ​ກູ້​ຄືນ ແລະ​ປິດ​ໃຊ້​ງານ
ໂໝດ​ຜູ້​ພັດ​ທະ​ນາ ເພື່ອ​ເປີດ​ໃຊ້​ງານ​ການ​ຢືນ​ຢັນ. ສຳ​ລັບ​ຂໍ້​ມູນ​ເພີ່ມ​ເຕີມ,
ໃຫ້​ເບິ່ງ URL ນີ້:

https://www.google.com/chromeos/recovery</translation>
<translation id="4410491068110727276">ໃຊ້ປຸ່ມລະດັບສຽງເພື່ອນຳທາງຂຶ້ນ ຫຼື ລົງ.</translation>
<translation id="4412740632134951267">ເລືອກຕົວເລືອກຂັ້ນສູງທາງລຸ່ມເພື່ອປ່ຽນ</translation>
<translation id="4486160941938493301">ຫາກທ່ານຕ້ອງການເລືອກວິທີກູ້ຄືນແບບອື່ນ, ໃຫ້ກັບໄປໂດຍການກົດ Esc + ໂຫຼດຂໍ້ມູນຄືນໃໝ່ + ເປີດປິດ</translation>
<translation id="4503421634496749265">ກະລຸນາລອງໃໝ່. ກະລຸນາກວດສອບວ່າສຽບສາຍອຸປະກອນແລ້ວ ແລະ ກຳລັງສາກຢູ່.</translation>
<translation id="4652489998517778111">ກະລຸນາປິດ​ເປີດ​ໃໝ່ແລ້ວລອງອີກເທື່ອໜຶ່ງ</translation>
<translation id="4791159253869531619">ກວດພົບດິສພາຍນອກທີ່ມີຮູບການກູ້ຄືນ</translation>
<translation id="4851795211104228792">ຕອນນີ້ທ່ານຈະຖືກອັບເດດເປັນເວີຊັນສະຖຽນຫຼ້າສຸດ (ແນະນຳ)</translation>
<translation id="4905949142713655149">ເກີດ​ຄວາມ​ຜິດ​ພາດ​ບໍ່​ຄາດ​ຄິດ​ຂຶ້ນ.  ກະ​ລຸ​ນາ​ເບິ່ງ URL ນີ້​ສຳ​ລັບ​ເຄັດ​ລັບ​ການ​ແກ້​ໄຂ​ບັນ​ຫາ:

https://www.google.com/chromeos/recovery</translation>
<translation id="496201662522655493">ການກູ້ຄືນລະບົບສຳເລັດແລ້ວ.

ຕອນນີ້ປອດໄພແລ້ວໃນການລຶບສື່ການກູ້ຄືນອອກ. ຄອມພິວເຕີຂອງທ່ານຈະ
ປິດເປີດຄືນໃໝ່ໂດຍອັດຕະໂນມັດໃນໄວໆນີ້.</translation>
<translation id="5080881219404532322">ທ່ານກຳລັງຈະກູ້ຄືນອຸປະກອນຂອງທ່ານ. ກະລຸນາກວດໃຫ້ແນ່ໃຈວ່າມັນ
 ສຽບກັບແຫຼ່ງຈ່າຍໄຟ.
ຖ້າທ່ານຕ້ອງການຍົກເລີກການກູ້ຄືນ, ກະລຸນາກົດປຸ່ມເປີດປິດຄ້າງໄວ້ຈົນກວ່າວ່າຄອມພິວເຕີປິດ (ນີ້ຈະໃຊ້ເວລາບໍ່ເກີນ 8 ວິນາທີ).
ເຮັດສິ່ງໄດ້ຢ່າງປອດໄພທຸກເວລາໃນລະຫວ່າງການຢັ້ງຢືນ.</translation>
<translation id="51254621993922230">ກູ້ຄືນສຳເລັດແລ້ວ</translation>
<translation id="537291066186627789">ການ​ກູ້​ຄືນ​ລະ​ບົບ​ສຳ​ເລັດ.

ກະ​ລຸ​ນາ​ເອົາ​ມີ​ເດຍ​ການ​ກູ້​ຄືນ​ອອກ ແລະ​ຄອມ​ພິວ​ເຕີ​ຂອງ​ທ່ານ​ຈະ​ປິດ​ເປີດ​ໃໝ່​ອັດ​ຕະ​ໂນ​ມັດ​.</translation>
<translation id="544118001572747892">ປະ​ກົດ​ວ່າ​ຄອມ​ພິວ​ເຕີ​ຂອງ​ທ່ານ​ບໍ່​ແມ່ນ​ລະ​ບົບ Chrome OS!

