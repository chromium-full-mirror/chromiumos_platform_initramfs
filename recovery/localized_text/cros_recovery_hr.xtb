<translation id="1995660704900986789">Isključi</translation>
<translation id="2238107357612570504">Opcije otklanjanja pogreški oporavka</translation>
<translation id="2596600434078055015">Opcije otklanjanja pogreški oporavka</translation>
<translation id="2731700343119398978">Pričekajte...</translation>
