# * * * EXPERIMENTAL * * *
# Experimental /init script for use in the hypervisor initramfs.
#

# Prepare standard paths and mount points.
setup_environment() {
  # Install additional utility programs.
  /bin/busybox --install /bin || true

  mount -n -t sysfs -o nodev,noexec,nosuid sysfs /sys
  mount -n -t proc -o nodev,noexec,nosuid none /proc
  mount -n -t devtmpfs -o mode=0755,nosuid devtmpfs /dev

  mkdir /dev/pts
  mount -n -t devpts -o noexec,nosuid,mode=0600 devpts /dev/pts

  # enable huge page shared memory allocations
  echo "always" > /sys/kernel/mm/transparent_hugepage/shmem_enabled
}

# Bind PCI device to VFIO-PCI passthrough bus.
vfio_pci() {
  local sysfs=$1
  local bdf=$(basename "${sysfs}")
  local vendor_id=$(cat "${sysfs}/vendor")
  local device_id=$(cat "${sysfs}/device")
  local class=$(cat "${sysfs}/class")

  # Filter by CLASS
  case "${class}" in
  0x060000)
    return 1  # Ignore PCI Host Bridge.
    ;;
  0x060400)
    return 1  # Ignore PCI-PCI Bridge.
    ;;
  esac

  # Filter by BDF.
  case "${bdf}" in
  0000:00:1e.?)
    # Ignore LPSS/UART Communication device group.
    return 1
    ;;
  esac

  # Detach from current driver if any.
  local driver="${sysfs}/driver"
  if [[ -f "${driver}/unbind" ]]; then
    echo "${bdf}" > "${driver}/unbind"
  fi

  # Disable VFIO functional reset.
  echo 1 > /sys/module/vfio_pci/parameters/disable_function_reset
  # Attach pci device to VFIO-PCI bus driver.
  echo "${vendor_id} ${device_id}" > /sys/bus/pci/drivers/vfio-pci/new_id
}

# Generate ACPI table list argument.
acpi_list() {
  local acpi=
  for acpi in DSDT SSDT NHLT TPM2 HPET DBG2; do
    if [ -f "/sys/firmware/acpi/tables/${acpi}" ]; then
      echo " --acpi-table /sys/firmware/acpi/tables/${acpi}"
    fi
  done
}

# Get guest kernel command line options.
cmdline() {
  local cmd="$(cat /proc/cmdline)"

  # ACPI workarounds
  cmd="acpi_enforce_resources=no acpi=noirq acpi=verbose ${cmd}"

  # PCI workaround
  cmd="pci=lastbus=64 pci=nocrs ${cmd}"

  # Uncomment to disable standard boot flow.
  # cmd="${cmd/init=*root=/root=} init=/bin/bash"

  # Uncomment for incorrect rootfs UUID workaround
  # cmd="${cmd/root=*\ rootwait/root=\/dev\/nvme0n1p3}"

  echo "${cmd}"
}

# Start ManaTEE Monitor.
run_trichechus() {
  if [[ -x "/sbin/trichechus" ]]; then
    start-stop-daemon -S -b -x "/sbin/trichechus"
  fi
}

# Start primary guest VM.
run_crosvm() {
  local args="-s /run/crosvm.sock --cid 3"

  # TODO: enable minijail sandboxing.
  args="${args} --disable-sandbox"

  # Use all available CPUs for primary VM.
  local nproc=$(nproc)
  local affinity=$(for n in $(seq 0 $((nproc - 1))); do echo -n "$n=$n:"; done)
  args="${args} --cpus ${nproc} --cpu-affinity ${affinity%?}"

  # Reserve 512MB of total system memory for hypervisor.
  local mem_total=$(grep MemTotal /proc/meminfo)
  local mem_kb=${mem_total//[^0-9]/}
  local mem_vm=$((mem_kb/1024 - 512))
  args="${args} --mem ${mem_vm}"

  # Direct attach all available PCI devices.
  for dev in `find /sys/bus/pci/devices -type l | sort`; do
    vfio_pci "${dev}"
    if [[ $? -eq 0 ]]; then
      args="${args} --vfio ${dev}"
    fi
  done

  # TODO: enable ACPI table parser and GSI forwarding.
  # args="${args} $(acpi_list)"

  /sbin/crosvm run ${args} --params "$(cmdline)" /boot/vmlinuz
}

# Resume primary guest VM.
resume_crosvm() {
  /sbin/crosvm resume -s /run/crosvm.sock
}

# Start serial bash access.
run_console() {
  local serial=
  if [ -c "/dev/ttyMSM0" ]; then
    serial="/dev/ttyMSM0"
  elif [ -c "/dev/ttyS0" ]; then
    serial="/dev/ttyS0"
  else
    # No serial device found.
    return
  fi
  sh >"${serial}" <"${serial}" 2>&1
}

# Suzy-Q debug access.
debug_tty() {
  local reply=
  echo "########################################################"
  read -t 5 -p "Enter console debug [yes|NO]: " reply
  case "${reply}" in
  "y" | "Y" | "yes" | "YES")
    # Start console, continue to crosvm boot
    run_console
    ;;
  *)
    ;;
  esac
}

# Force host system reboot.
# TODO: handle ACPI reboot/shutdown requests.
die() {
  reboot -f
}

# Main.
main() {
  setup_environment
  debug_tty

  # Start ManaTEE Monitor.
  run_trichechus

  # Start primary guest VM, terminate on successful VM exit.
  run_crosvm 2>&1 | tee -a /var/log/crosvm.log && die

  # Failover to debug console
  run_console
}

# Make this source-able for testing.
if [ "$0" = "/init" ]; then
  main "$@"
  # Should never reach here. Failed to start VM.
  exit 1
fi
