# ALERT!
#
# The color constants below are duplicated in make_text_images.  If
# you change them here, you must also change them there, and vice
# versa.

BG='#607c91'
COLOR='#9ccaec'
# End Alert

. $(dirname $0)/constants.sh
SUPPORTED_LOCALES="de en-GB en-US es fr it ko nl"

report() {
  echo "wrote $1"
}

# Each locale includes a message image named 'empty' containing
# no text.  We hard-code the generation of that image here, and
# replicate the image for each locale.
#
# Arg 1: destination directory where the locale directories should
#   exist.
# Args 2 and on:  locales for which the 'empty.png' file is to be
#   created.
make_empty_messages() {
  local empty=empty.png
  local dstdir=$1
  shift
  convert -size ${MESSAGE_BOX_WIDTH}x${MESSAGE_BOX_HEIGHT} "xc:$BG" $empty
  for localedir in "$@"; do
    if [ ! -d $dstdir/$localedir ]; then
      continue
    fi
    ln -f $empty $dstdir/$localedir
    report $localedir/$empty
  done
  rm $empty
}

# Create the images used for the progress bar in make_user_wait
#
# Arg 1: Destination directory for the image files.
make_progress_bar() {
  local dstdir=$1

  local border=$PROGRESS_BAR_BORDER  # width of the outer and inner borders
  local bar_width=$PROGRESS_BAR_WIDTH
  local bar_height=$PROGRESS_BAR_HEIGHT

  local box_width=$(( PROGRESS_BAR_WIDTH + 4 * border ))
  local box_height=$(( PROGRESS_BAR_HEIGHT + 4 * border ))

  local border_left=$(( border / 2 ))
  local border_right=$(( box_width - border_left - 1 ))

  local border_top=$(( border / 2 ))
  local border_bottom=$(( box_height - border_top - 1 ))

  # coordinates of top-left and bottom-right, respectively, of
  # the outer rectangular border.
  local border_tl=$border_left,$border_top
  local border_br=$border_right,$border_bottom

  local image_file=$dstdir/progress_box.png
  convert -size ${box_width}x${box_height} "xc:$BG" \
    -stroke "$COLOR" -strokewidth $border -fill "$BG" \
    -draw "rectangle $border_tl $border_br" \
    $image_file
  report $image_file

  convert -size ${PROGRESS_BAR_PERCENT}x${bar_height} "xc:$COLOR" \
    $dstdir/progress_increment.png
  report $dstdir/progress_increment.png
}


# Create the moving box animation frames.  Roughly, the frame
# sequence looks like this:
#    Frame 0        Frame 1        Frame 2
#   ============   ============   ============
#   =          =   =          =   =          =
#   = bb       =   =    bb    =   =       bb =
#   = bb       =   =    bb    =   =       bb =
#   =          =   =          =   =          =
#   ============   ============   ============
#
# The '=' characters represent an outer rectangle forming a border
# around the path of the moving box.  The path of the moving box
# itself is smaller than the interior of the outer rectangle, so
# that there is an inner border surrounding the path.  The box and
# the outer border are drawn in the foreground color; the path and
# the inner border are drawn in the background color.
#
# Arg 1: Destination directory for the image files.
make_moving_box_frames() {
  local dstdir=$1

  local border=$PROGRESS_BAR_BORDER  # width of the outer and inner borders
  local box=$PROGRESS_BAR_HEIGHT     # width and height of the moving box
  local nbox=40                      # frames are numbered 0..$nbox
  local speed=6                      # number of pixels the box moves each frame

  local path_width=$(( speed * nbox + box ))
  local path_left=$(( (MESSAGE_BOX_WIDTH - path_width) / 2 ))
  local path_right=$(( path_left + path_width ))

  local path_height=$box
  local path_top=160
  local path_bottom=$(( path_top + path_height ))

  # coordinates of top-left and bottom-right, respectively, of
  # the outer rectangular border.
  local border_tl=$(( path_left - border - 1 )),$(( path_top - border - 1 ))
  local border_br=$(( path_right + border )),$(( path_bottom + border ))

  for index in $(seq 0 $nbox); do
    # coordinates of top-left and bottom-right, respectively, of
    # the moving box for this frame.
    local box_left=$(( path_left + index * speed ))
    local box_tl=$box_left,$path_top
    local box_br=$(( box_left + box )),$path_bottom
    zindex=$(printf "%02d" $index)
    local image_file=$dstdir/moving_box_${zindex}.png
    convert -size ${MESSAGE_BOX_WIDTH}x${MESSAGE_BOX_HEIGHT} "xc:$BG" \
      -stroke "$COLOR" -strokewidth $border -fill "$BG" \
      -draw "rectangle $border_tl $border_br" \
      -stroke "$BG" -strokewidth $border -fill "$COLOR" \
      -draw "rectangle $box_tl $box_br" \
      $image_file
    report $image_file
  done
}

SRCDIR=localized_text
DSTDIR=screens
rm -rf $DSTDIR
mkdir -p $DSTDIR

# The size for the background is selected to be large enough to
# cover the full screen on either Alex or ZGB; we rely on the fact
# that ply-image will clip the image to fit.
#
# TODO(jrbarnette):  If/when we have to support more screen sizes,
# this solution won't scale.  Some new feature in ply-image is
# likely to be required.
convert -size 1366x800 "xc:$BG" $DSTDIR/background.png
report $DSTDIR/background.png

for locale in $SUPPORTED_LOCALES ; do
  $(dirname $0)/make_text_images $SRCDIR $DSTDIR $locale
done

make_empty_messages $DSTDIR $SUPPORTED_LOCALES

make_progress_bar $DSTDIR

make_moving_box_frames $DSTDIR
