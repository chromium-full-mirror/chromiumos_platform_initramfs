LOG_FILE=/dev/kmsg

# Kernel log-levels.
LOG_INFO="<6>"
LOG_ERROR="<3>"

# Tag for log messages.
TAG="flexor-init"

# shellcheck source=/dev/null
. /usr/bin/write_gpt.sh
# shellcheck source=../common/init.sh
. /lib/init.sh

flexor_info() {
  echo "${LOG_INFO}${TAG}: $*" | tee "${LOG_FILE}" 1>&2
}

flexor_err() {
  echo "${LOG_ERROR}${TAG}: $*" | tee "${LOG_FILE}" 1>&2
}

# For initramfs, this init script is responsible for the equivalent of
# `prepare_namespace()`. For Flexor this simplifies to waiting for the
# fixed block devices to become available.
wait_for_fixed_dst_drive() {
  # Wait up to 10 seconds.
  local NUM_TRIES=100
  local SLEEP_SECONDS=0.1

  load_base_vars
  flexor_info "Looking for destination drive ..."

  local try=0
  while [ $(( try += 1 )) -lt "${NUM_TRIES}" ]; do
    DST="$(get_fixed_dst_drive)"
    if [ -n "${DST}" ]; then
      flexor_info "Found destination drive: ${DST}"
      return 0
    fi
    sleep "${SLEEP_SECONDS}"
  done

  flexor_err "Failed waiting for destination drive"
  return 1
}

main() {
  initialize
  wait_for_fixed_dst_drive

  flexor_info "Done initializing, start installation"
  exec /sbin/flexor --device="$(get_fixed_dst_drive)"
}

if [ "$0" = "/init" ]; then
  main "$@"
  # Should never reach here.
  exit 1
fi
